    "settings.cache_deletion_help": {
      "extractionState": "manual",
      "comment": "Explains cache-retention behavior.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes everything cached on disk - thumbnails, previews, and originals - for the current account, as if you just signed in. Thumbnails re-crawl automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alles lokal Gecachte - Thumbnails, Vorschauen und Originale - für den aktuellen Account, wie frisch eingeloggt. Thumbnails werden automatisch neu geladen."
          }
        }
      }
    },
    "settings.sign_out_help": {
      "extractionState": "manual",
      "comment": "Explains the sign-out button in Settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs out of the Proton account on this Mac and removes its local data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet das Proton-Konto auf diesem Mac ab und entfernt dessen lokale Daten."
          }
        }
      }
    },
