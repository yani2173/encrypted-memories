{
  "sourceLanguage": "en",
  "strings": {
    "%@ / %@": {
      "comment": "Used and total Proton storage.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$@ / %2$@" } },
        "de": { "stringUnit": { "state": "translated", "value": "%1$@ / %2$@" } }
      }
    },
    "%lld GB": {
      "comment": "Cache size in gigabytes.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld GB" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld GB" } }
      }
    },
    "%lld/%lld": {
      "comment": "Compact current and total count.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$lld/%2$lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "%1$lld/%2$lld" } }
      }
    },
    "settings.photos_backup_section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photos Library" } },
        "de": { "stringUnit": { "state": "translated", "value": "Foto-Mediathek" } }
      }
    },
    "settings.backup_tab": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup" } },
        "de": { "stringUnit": { "state": "translated", "value": "Backup" } }
      }
    },
    "settings.backup_folders_section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Folders" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ordner" } }
      }
    },
    "settings.backup_no_folders": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No folders selected yet. Added folders are backed up to Proton Drive, encrypted." } },
        "de": { "stringUnit": { "state": "translated", "value": "Noch keine Ordner ausgewählt. Hinzugefügte Ordner werden verschlüsselt in Proton Drive gesichert." } }
      }
    },
    "settings.backup_add_folder": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add Folder…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ordner hinzufügen…" } }
      }
    },
    "settings.backup_add_folder_prompt": {
      "extractionState": "manual",
      "comment": "Confirm button of the folder picker panel.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Back Up Folder" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ordner sichern" } }
      }
    },
    "settings.backup_full_disk_access_setup": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The first click opens Full Disk Access settings. Grant access, return here, then click Add Folder again." } },
        "de": { "stringUnit": { "state": "translated", "value": "Beim ersten Klick werden die Einstellungen für Festplattenvollzugriff geöffnet. Erteile den Zugriff, kehre hierher zurück und klicke erneut auf Ordner hinzufügen." } }
      }
    },
    "settings.backup_folder_stale": {
      "extractionState": "manual",
      "comment": "Shown under a folder whose sandbox bookmark no longer resolves.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Access must be renewed - please add this folder again" } },
        "de": { "stringUnit": { "state": "translated", "value": "Zugriff muss erneuert werden - bitte Ordner erneut hinzufügen" } }
      }
    },
    "settings.backup_folder_error_permission %@": {
      "extractionState": "manual",
      "comment": "Shown when a registered backup folder cannot be read. %@ is the affected name.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup stopped because %@ could not be read. Check its permissions and try again." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Sicherung wurde beendet, weil %@ nicht gelesen werden konnte. Prüfe die Berechtigungen und versuche es erneut." } }
      }
    },
    "settings.backup_folder_error_missing %@": {
      "extractionState": "manual",
      "comment": "Shown when a registered backup folder or child disappears. %@ is the affected name.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup stopped because %@ is no longer available. Select the folder again and retry." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Sicherung wurde beendet, weil %@ nicht mehr verfügbar ist. Wähle den Ordner erneut aus und versuche es noch einmal." } }
      }
    },
    "settings.backup_folder_error_transient %@": {
      "extractionState": "manual",
      "comment": "Shown for another file-system error during folder backup. %@ is the affected name.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup could not finish reading %@. Try again." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Sicherung konnte %@ nicht vollständig lesen. Versuche es erneut." } }
      }
    },
    "settings.backup_status_section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup status" } },
        "de": { "stringUnit": { "state": "translated", "value": "Backup-Status" } }
      }
    },
    "settings.backup_unavailable": {
      "extractionState": "manual",
      "comment": "Shown when the duplicate-protection store could not be opened; backup is disabled rather than risking double uploads.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup is unavailable because duplicate protection could not be initialized." } },
        "de": { "stringUnit": { "state": "translated", "value": "Backup ist nicht verfügbar, weil der Duplikatschutz nicht initialisiert werden konnte." } }
      }
    },
    "settings.backup_sync_now": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Back up now" } },
        "de": { "stringUnit": { "state": "translated", "value": "Jetzt sichern" } }
      }
    },
    "settings.albumsync_section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photos Albums" } },
        "de": { "stringUnit": { "state": "translated", "value": "Foto-Alben" } }
      }
    },
    "settings.backup_stop": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stop" } },
        "de": { "stringUnit": { "state": "translated", "value": "Stoppen" } }
      }
    },
    "settings.backup_backed_up %lld %lld": {
      "comment": "Verified backup count followed by the total item count.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$lld of %2$lld backed up" } },
        "de": { "stringUnit": { "state": "translated", "value": "%1$lld von %2$lld gesichert" } }
      }
    },
    "settings.backup_row_skipped_deleted %lld": {
      "comment": "Items skipped because their identical Proton Drive copy was deleted.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Skipped (deleted in Proton Drive): %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Übersprungen (in Proton Drive gelöscht): %lld" } }
      }
    },
    "settings.backup_row_source_missing %lld": {
      "comment": "Items that are no longer present in the selected source folder.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No longer on this Mac: %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Nicht mehr auf diesem Mac: %lld" } }
      }
    },
    "settings.backup_row_blocked %lld": {
      "comment": "Items that wait for an automatic retry.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Will be re-checked later: %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Werden später erneut geprüft: %lld" } }
      }
    },
    "settings.backup_row_failed %lld": {
      "comment": "Items that need attention after a backup failure.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Need attention: %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Benötigen Aufmerksamkeit: %lld" } }
      }
    },
    "action.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        }
      }
    },
    "albums.cover_failed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cover Not Changed" } },
        "de": { "stringUnit": { "state": "translated", "value": "Cover nicht geändert" } }
      }
    },
    "albums.cover_failed_message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The album cover couldn't be changed. Your selection is still available.\n\n%@" } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Albumcover konnte nicht geändert werden. Deine Auswahl ist weiterhin verfügbar.\n\n%@" } }
      }
    },
    "alert.trash_action_failed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action Failed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion fehlgeschlagen"
          }
        }
      }
    },
    "alert.trash_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos couldn't be moved to Recently Deleted. They are still in your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos konnten nicht in „Zuletzt gelöscht“ verschoben werden. Sie sind weiterhin in deiner Mediathek."
          }
        }
      }
    },
    "alert.restore_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos couldn't be restored. They are still in Recently Deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos konnten nicht wiederhergestellt werden. Sie sind weiterhin in „Zuletzt gelöscht“."
          }
        }
      }
    },
    "login.tagline": {
      "extractionState": "manual",
      "comment": "Product tagline under the app name on the login screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos, end-to-end encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos, Ende-zu-Ende-verschlüsselt."
          }
        }
      }
    },
    "login.help_text": {
      "extractionState": "manual",
      "comment": "Explains the browser-based sign-in flow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your browser to sign in securely. No password is ever entered in this app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet deinen Browser zur sicheren Anmeldung. In dieser App wird niemals ein Passwort eingegeben."
          }
        }
      }
    },
    "loading.building_library": {
      "extractionState": "manual",
      "comment": "Caption while the photo backend initializes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building your library…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek wird aufgebaut …"
          }
        }
      }
    },
    "error.library_open_failed": {
      "extractionState": "manual",
      "comment": "Title on the backend-error screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open your library"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek konnte nicht geöffnet werden"
          }
        }
      }
    },
    "error.no_photos_library": {
      "extractionState": "manual",
      "comment": "Shown when the account has no photo share yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Photos library was found on this account yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto wurde noch keine Fotomediathek gefunden."
          }
        }
      }
    },
    "menu.upload_photos": {
      "extractionState": "manual",
      "comment": "File menu item (⌘U).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Photos…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos hochladen …"
          }
        }
      }
    },
    "menu.upload_folder": {
      "extractionState": "manual",
      "comment": "File menu item (⌘⇧U).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Folder…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner hochladen …"
          }
        }
      }
    },
    "menu.show_uploads": {
      "extractionState": "manual",
      "comment": "Opens the upload queue.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Uploads"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads anzeigen"
          }
        }
      }
    },
    "menu.toggle_sidebar": {
      "extractionState": "manual",
      "comment": "View menu item (⌥⌘S).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Sidebar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenleiste ein-/ausblenden"
          }
        }
      }
    },
    "menu.refresh_library": {
      "extractionState": "manual",
      "comment": "View menu item (⌘⇧R).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh Library"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediathek aktualisieren"
          }
        }
      }
    },
    "sidebar.all_photos": {
      "extractionState": "manual",
      "comment": "Sidebar item for the whole library.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Fotos"
          }
        }
      }
    },
    "sidebar.map": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Map" } },
        "de": { "stringUnit": { "state": "translated", "value": "Karte" } }
      }
    },
    "sidebar.albums_loading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading albums…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Alben werden geladen…" } }
      }
    },
    "sidebar.albums_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry loading albums" } },
        "de": { "stringUnit": { "state": "translated", "value": "Alben erneut laden" } }
      }
    },
    "sidebar.albums": {
      "extractionState": "manual",
      "comment": "Sidebar section header for user albums.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben"
          }
        }
      }
    },
    "sidebar.no_albums": {
      "extractionState": "manual",
      "comment": "Disabled sidebar row shown when the account has no albums.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Albums"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Alben"
          }
        }
      }
    },
    "sidebar.recently_deleted": {
      "extractionState": "manual",
      "comment": "Sidebar item / title for the trash.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recently Deleted"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt gelöscht"
          }
        }
      }
    },
    "export.button": {
      "extractionState": "manual",
      "comment": "Confirmation button in the export-folder chooser.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren"
          }
        }
      }
    },
    "alert.trash_confirmation_title_one": {
      "extractionState": "manual",
      "comment": "Trash confirmation title (single photo).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move photo to Trash?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto in den Papierkorb verschieben?"
          }
        }
      }
    },
    "alert.trash_confirmation_title_other %lld": {
      "extractionState": "manual",
      "comment": "Trash confirmation title (multiple photos). %lld is the count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %lld photos to Trash?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Fotos in den Papierkorb verschieben?"
          }
        }
      }
    },
    "alert.trash_confirmation_message_one": {
      "extractionState": "manual",
      "comment": "Trash confirmation message (single photo).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo will move to Recently Deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto wird nach „Zuletzt gelöscht“ verschoben."
          }
        }
      }
    },
    "alert.trash_confirmation_message_other": {
      "extractionState": "manual",
      "comment": "Trash confirmation message (multiple photos).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photos will move to Recently Deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Fotos werden nach „Zuletzt gelöscht“ verschoben."
          }
        }
      }
    },
    "alert.move_to_trash": {
      "extractionState": "manual",
      "comment": "Destructive confirmation button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb verschieben"
          }
        }
      }
    },
    "upload.uploaded": {
      "extractionState": "manual",
      "comment": "Banner shown after an upload lands in the library.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochgeladen"
          }
        }
      }
    },
    "library.refreshed": {
      "extractionState": "manual",
      "comment": "Banner shown after a manual library refresh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library refreshed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediathek aktualisiert"
          }
        }
      }
    },
    "upload.refreshing_after_upload": {
      "extractionState": "manual",
      "comment": "Banner while the library refreshes after an upload.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload complete, refreshing library…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload abgeschlossen, Mediathek wird aktualisiert …"
          }
        }
      }
    },
    "upload.waiting_for_refresh": {
      "extractionState": "manual",
      "comment": "Banner during a retry delay after upload.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload complete, waiting for library refresh…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload abgeschlossen, warten auf Mediathek-Aktualisierung …"
          }
        }
      }
    },
    "upload.not_yet_indexed": {
      "extractionState": "manual",
      "comment": "Banner when post-upload refresh retries are exhausted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload completed, but the library hasn’t indexed it yet. Use Refresh Library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload abgeschlossen, aber die Mediathek hat ihn noch nicht indexiert. Verwende „Mediathek aktualisieren“."
          }
        }
      }
    },
    "library.refreshing": {
      "extractionState": "manual",
      "comment": "Banner during a manual library refresh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing library…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediathek wird aktualisiert …"
          }
