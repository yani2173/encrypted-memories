    "settings.offline_library_help": {
      "extractionState": "manual",
      "comment": "Help text under the Offline Library toggle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened photos are stored locally (encrypted) and stay available offline. Offline you only get thumbnails and photos you already opened - no videos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnete Fotos bleiben lokal (verschlüsselt) gespeichert und sind auch offline verfügbar. Offline gibt es nur Thumbnails und bereits geöffnete Fotos – keine Videos."
          }
        }
      }
    },
