{
  "sourceLanguage": "en",
  "strings": {
    "backup.issue_unknown_waiting": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Not finished yet." } },
        "de": { "stringUnit": { "state": "translated", "value": "Noch nicht fertig." } }
      }
    },
    "backup.issue_permanent": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This photo cannot be backed up." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieses Foto kann nicht gesichert werden." } }
      }
    },
    "backup.issue_source_not_ready": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The camera is still processing this photo."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Kamera bearbeitet dieses Foto noch."}}
      }
    },
    "backup.issue_source_missing": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This photo is no longer on this device."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dieses Foto ist nicht mehr auf diesem Gerät."}}
      }
    },
    "backup.section_action_needed": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Action needed"}},
        "de": {"stringUnit": {"state": "translated", "value": "Handlung erforderlich"}}
      }
    },
    "backup.section_continues_by_itself": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Continues by itself"}},
        "de": {"stringUnit": {"state": "translated", "value": "Läuft von selbst weiter"}}
      }
    },
    "backup.section_not_possible": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Not possible"}},
        "de": {"stringUnit": {"state": "translated", "value": "Nicht möglich"}}
      }
    },
    "backup.phase_waiting_proton": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Waiting for Proton"}},
        "de": {"stringUnit": {"state": "translated", "value": "Warten auf Proton"}}
      }
    },
    "backup.phase_not_backed_up %lld": {
      "extractionState": "manual",
      "comment": "Backup headline: photos that are not backed up and need the person or cannot be backed up.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": { "stringUnit": { "state": "translated", "value": "%lld photo not backed up" } },
              "other": { "stringUnit": { "state": "translated", "value": "%lld photos not backed up" } }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": { "stringUnit": { "state": "translated", "value": "%lld Foto nicht gesichert" } },
              "other": { "stringUnit": { "state": "translated", "value": "%lld Fotos nicht gesichert" } }
            }
          }
        }
      }
    },
    "backup.issue_deleted_elsewhere" : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung dieses Fotos wurde aus Proton Drive entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup of this photo was removed from Proton Drive."
          }
        }
      }
    },
    "backup.issue_deletion_check" : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob dieses Foto noch in Proton Drive ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking whether this photo is still in Proton Drive."
          }
        }
      }
    },
    "backup.keep_deleted" : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Deleted"
          }
        }
      }
    },
    "backup.back_up_again" : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up Again"
          }
        }
      }
    },

    "backup.issue_waiting_original": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The edited photo waits for its original." } },
