diff --git a/Sources/Client/ProtonDriveClient/EventEnumerationCancellationState.swift b/Sources/Client/ProtonDriveClient/EventEnumerationCancellationState.swift
new file mode 100644
index 0000000..b8d0022
--- /dev/null
+++ b/Sources/Client/ProtonDriveClient/EventEnumerationCancellationState.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// Exactly-once owner for one event request's Swift continuation and native cancellation token.
+///
+/// Explicit API cancellation and Swift task cancellation can race. Both enter this owner, which releases the
+/// continuation immediately, runs native cancellation at most once, and joins cancellation before token free.
+final class EventEnumerationCancellationState: @unchecked Sendable {
+    let requestCancellation = SDKRequestHandler.RequestCancellation()
+
+    private let lock = NSLock()
+    private let cancelNative: @Sendable () async -> Void
+    private let freeNative: @Sendable () async -> Void
+    private var releaseTask: Task<Void, Never>?
+
+    init(tokenSource: CancellationTokenSource) {
+        self.cancelNative = { try? await tokenSource.cancel() }
+        self.freeNative = { await tokenSource.freeAndWait() }
+    }
+
+    init(
+        cancelNative: @escaping @Sendable () async -> Void,
+        freeNative: @escaping @Sendable () async -> Void
+    ) {
+        self.cancelNative = cancelNative
+        self.freeNative = freeNative
+    }
+
+    func cancelAndRelease() async {
+        requestCancellation.cancel()
+        await release(cancelNative: true)
+    }
+
+    func completeAndRelease() async {
+        await release(cancelNative: false)
+    }
+
+    private func release(cancelNative shouldCancelNative: Bool) async {
+        let task = lock.withLock { () -> Task<Void, Never> in
+            if let releaseTask { return releaseTask }
+            let cancelNative = self.cancelNative
+            let freeNative = self.freeNative
+            let task = Task {
+                if shouldCancelNative {
+                    await cancelNative()
+                }
+                await freeNative()
+            }
+            releaseTask = task
+            return task
+        }
+        await task.value
+    }
+}
