diff --git a/Tests/DriveEventEnumerationCallbackTests.swift b/Tests/DriveEventEnumerationCallbackTests.swift
new file mode 100644
index 0000000..e799e98
--- /dev/null
+++ b/Tests/DriveEventEnumerationCallbackTests.swift
@@ -0,0 +1,125 @@
+import CProtonDriveSDK
+import Foundation
+import SwiftProtobuf
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Drive event enumeration callback")
+struct DriveEventEnumerationCallbackTests {
+    @Test func voidRequestBoxDeliversStreamedEvent() throws {
+        let recorder = DriveEventCallbackRecorder()
+        let wrapper = DriveEventEnumerationCallbackWrapper(callback: recorder.record)
+        let box = BoxedCompletionBlock<Void, WeakReference<DriveEventEnumerationCallbackWrapper>>(
+            nil,
+            state: WeakReference(value: wrapper)
+        )
+        let handle = CallbackHandleRegistry.shared.register(box)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        let bytes = try eventBytes(id: "event-7")
+        defer { bytes.deallocate() }
+        cDriveEventEnumerationCallback(handle, bytes)
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.eventId == "event-7")
+        guard case .cursorAdvanced = delivered.kind else {
+            Issue.record("Expected a cursor-advanced event")
+            return
+        }
+    }
+
+    @Test func cancelledRequestDropsLateYieldWithoutNativeTerminalResponse() async throws {
+        let recorder = DriveEventCallbackRecorder()
+        let completion = VoidCompletionRecorder()
+        let lifecycle = LifecycleRecorder()
+        let wrapper = DriveEventEnumerationCallbackWrapper(callback: recorder.record)
+        let box = BoxedCompletionBlock<Void, WeakReference<DriveEventEnumerationCallbackWrapper>>(
+            completion.record,
+            state: WeakReference(value: wrapper)
+        )
+        let handle = CallbackHandleRegistry.shared.register(box)
+        let cancellation = EventEnumerationCancellationState(
+            cancelNative: { lifecycle.append("cancel") },
+            freeNative: { lifecycle.append("free") }
+        )
+        cancellation.requestCancellation.install(handle)
+
+        await cancellation.cancelAndRelease()
+        await cancellation.cancelAndRelease()
+
+        let bytes = try eventBytes(id: "late-event")
+        defer { bytes.deallocate() }
+        cDriveEventEnumerationCallback(handle, bytes)
+        sdkResponseCallbackWithState(handle, bytes)
+
+        #expect(completion.count == 1)
+        #expect(completion.wasCancelled)
+        #expect(recorder.value == nil)
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+        #expect(lifecycle.values == ["cancel", "free"])
+    }
+
+    @Test func cancellationBeforeCallbackHandleInstallationStillReleasesContinuation() async {
+        let completion = VoidCompletionRecorder()
+        let cancellation = EventEnumerationCancellationState(
+            cancelNative: {},
+            freeNative: {}
+        )
+        await cancellation.cancelAndRelease()
+
+        let box = BoxedCompletionBlock<Void, Void>(completion.record, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        cancellation.requestCancellation.install(handle)
+
+        #expect(completion.count == 1)
+        #expect(completion.wasCancelled)
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+    }
+
+    private func eventBytes(id: String) throws -> ByteArray {
+        var event = Proton_Drive_Sdk_DriveEvent()
+        event.id = id
+        event.cursorAdvanced = Proton_Drive_Sdk_EventsCursorAdvancedEvent()
+        return ByteArray(data: try event.serializedData())
+    }
+}
+
+private final class DriveEventCallbackRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storedValue: SDKDriveEvent?
+
+    func record(_ result: Result<SDKDriveEvent, any Error>) {
+        guard case let .success(value) = result else { return }
+        lock.withLock { storedValue = value }
+    }
+
+    var value: SDKDriveEvent? { lock.withLock { storedValue } }
+}
+
+private final class VoidCompletionRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var results: [Result<Void, any Error>] = []
+
+    func record(_ result: Result<Void, any Error>) {
+        lock.withLock { results.append(result) }
+    }
+
+    var count: Int { lock.withLock { results.count } }
+    var wasCancelled: Bool {
+        lock.withLock {
+            guard case let .failure(error)? = results.first else { return false }
+            return error is CancellationError
+        }
+    }
+}
+
+private final class LifecycleRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storedValues: [String] = []
+
+    func append(_ value: String) {
+        lock.withLock { storedValues.append(value) }
+    }
+
+    var values: [String] { lock.withLock { storedValues } }
+}
