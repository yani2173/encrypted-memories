@@ -0,0 +1,119 @@
+import CProtonDriveSDK
+import Foundation
+import SwiftProtobuf
+import Testing
+@testable import ProtonDriveSDK
+
+/// Every streamed enumeration awaits `Void` from `SDKRequestHandler.send`, so the registry holds a
+/// `BoxedCompletionBlock<Void, WeakReference<Wrapper>>` for each of these callbacks. Upstream 0.28+
+/// looks the box up with a checked cast; a callback declared with any other result type silently drops
+/// every yielded item.
+@Suite("Enumeration callbacks resolve Void request boxes")
+struct EnumerationCallbackTests {
+    @Test func timelineItemIsDeliveredFromVoidRequestBox() throws {
+        let recorder = ResultRecorder<PhotoTimelineItem>()
+        let wrapper = TimelineItemEnumerationCallbackWrapper(callback: recorder.record)
+        let handle = register(wrapper)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var item = Proton_Drive_Sdk_PhotosTimelineItem()
+        item.nodeUid = "volume~node-1"
+        item.captureTime = Google_Protobuf_Timestamp(seconds: 1_700_000_000)
+        try withBytes(of: item) { cTimelineItemEnumerationCallback(handle, $0) }
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.nodeUid.nodeID == "node-1")
+        #expect(delivered.captureTime == 1_700_000_000)
+    }
+
+    @Test func albumItemIsDeliveredFromVoidRequestBox() throws {
+        let recorder = ResultRecorder<AlbumItem>()
+        let wrapper = AlbumItemEnumerationCallbackWrapper(callback: recorder.record)
+        let handle = register(wrapper)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var item = Proton_Drive_Sdk_AlbumItem()
+        item.nodeUid = "volume~album-photo"
+        item.captureTime = Google_Protobuf_Timestamp(seconds: 42)
+        try withBytes(of: item) { cAlbumItemEnumerationCallback(handle, $0) }
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.nodeUid.nodeID == "album-photo")
+        #expect(delivered.captureTime == 42)
+    }
+
+    @Test func nodeResultIsDeliveredFromVoidRequestBox() throws {
+        let recorder = ResultRecorder<NodeResult>()
+        let wrapper = NodeResultEnumerationCallbackWrapper(callback: recorder.record)
+        let handle = register(wrapper)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var pair = Proton_Drive_Sdk_NodeResultPair()
+        pair.nodeUid = "volume~updated"
+        try withBytes(of: pair) { cNodeResultEnumerationCallback(handle, $0) }
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.nodeUid.nodeID == "updated")
+        #expect(delivered.error == nil)
+    }
+
+    @Test func nodeUidIsDeliveredFromVoidRequestBox() throws {
+        let recorder = ResultRecorder<SDKNodeUid>()
+        let wrapper = NodeUidEnumerationCallbackWrapper(callback: recorder.record)
+        let handle = register(wrapper)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var uid = Google_Protobuf_StringValue()
+        uid.value = "volume~shared"
+        try withBytes(of: uid) { cNodeUidEnumerationCallback(handle, $0) }
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.volumeID == "volume")
+        #expect(delivered.nodeID == "shared")
+    }
+
+    @Test func deviceIsDeliveredFromVoidRequestBox() throws {
+        let recorder = ResultRecorder<Device>()
+        let wrapper = DeviceEnumerationCallbackWrapper(callback: recorder.record)
+        let handle = register(wrapper)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var device = Proton_Drive_Sdk_Device()
+        device.uid = "device-7"
+        device.type = .macos
+        device.name = Proton_Drive_Sdk_StringResult.with { $0.value = "Studio" }
+        device.rootFolderUid = "volume~root"
+        device.creationTime = Google_Protobuf_Timestamp(seconds: 7)
+        device.shareID = "share"
+        try withBytes(of: device) { cDeviceEnumerationCallback(handle, $0) }
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.uid.deviceID == "device-7")
+        #expect(delivered.rootFolderUid.nodeID == "root")
+    }
+
+    /// Mirrors `SDKRequestHandler.send` for `let _: Void = try await send(...)`: the completion result
+    /// type is `Void` and the state is the weak wrapper reference.
+    private func register<Wrapper: AnyObject>(_ wrapper: Wrapper) -> RegistryHandle {
+        let box = BoxedCompletionBlock<Void, WeakReference<Wrapper>>(nil, state: WeakReference(value: wrapper))
+        return CallbackHandleRegistry.shared.register(box)
+    }
+
+    private func withBytes(of message: some Message, _ body: (ByteArray) -> Void) throws {
+        let bytes = ByteArray(data: try message.serializedData())
+        defer { bytes.deallocate() }
+        body(bytes)
+    }
+}
+
+private final class ResultRecorder<Value: Sendable>: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storedValue: Value?
+
+    func record(_ result: Result<Value, any Error>) {
+        guard case let .success(value) = result else { return }
+        lock.withLock { storedValue = value }
+    }
+
+    var value: Value? { lock.withLock { storedValue } }
+}
