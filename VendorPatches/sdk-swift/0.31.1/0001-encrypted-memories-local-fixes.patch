+import CProtonDriveSDK
+import Foundation
+import SwiftProtobuf
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Thumbnail enumeration callback")
+struct ThumbnailEnumerationCallbackTests {
+    @Test func voidRequestBoxDeliversStreamedThumbnail() throws {
+        let expectedUID = SDKNodeUid(volumeID: "volume", nodeID: "node")
+        let expectedData = Data([0x01, 0x02, 0x03])
+        let recorder = ThumbnailCallbackRecorder()
+        let wrapper = ThumbnailEnumerationCallbackWrapper(callback: recorder.record)
+        let box = BoxedCompletionBlock<Void, WeakReference<ThumbnailEnumerationCallbackWrapper>>(
+            nil,
+            state: WeakReference(value: wrapper)
+        )
+        let handle = CallbackHandleRegistry.shared.register(box)
+        defer { CallbackHandleRegistry.shared.remove(handle) }
+
+        var thumbnail = Proton_Drive_Sdk_FileThumbnail()
+        thumbnail.fileUid = expectedUID.sdkCompatibleIdentifier
+        thumbnail.data = expectedData
+        let bytes = ByteArray(data: try thumbnail.serializedData())
+        defer { bytes.deallocate() }
+
+        cThumbnailEnumerationCallback(handle, bytes)
+
+        let delivered = try #require(recorder.value)
+        #expect(delivered.fileUid.volumeID == expectedUID.volumeID)
+        #expect(delivered.fileUid.nodeID == expectedUID.nodeID)
+        guard case let .success(data) = delivered.result else {
+            Issue.record("expected thumbnail bytes")
+            return
+        }
+        #expect(data == expectedData)
+    }
+}
+
+private final class ThumbnailCallbackRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storedValue: ThumbnailDataWithId?
+
+    func record(_ result: Result<ThumbnailDataWithId?, any Error>) {
+        guard case let .success(value?) = result else { return }
+        lock.withLock { storedValue = value }
+    }
+
+    var value: ThumbnailDataWithId? { lock.withLock { storedValue } }
+}
diff --git a/Tests/UploadLifecycleSupportTests.swift b/Tests/UploadLifecycleSupportTests.swift
new file mode 100644
index 0000000..2085db2
--- /dev/null
+++ b/Tests/UploadLifecycleSupportTests.swift
@@ -0,0 +1,250 @@
+import Foundation
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Upload lifecycle ownership")
+struct UploadLifecycleSupportTests {
+    @Test func cancellationBeforeNativeRegistrationClaimsOnlyOnce() {
+        let latch = UploadCancellationLatch()
+
+        latch.requestCancellation()
+
+        #expect(latch.isCancellationRequested)
+        #expect(latch.claimNativeCancellation())
+        #expect(!latch.claimNativeCancellation())
+    }
+
+    @Test func concurrentNativeCancellationClaimsOneCaller() async {
+        let latch = UploadCancellationLatch()
+        let claims = ClaimCounter()
+
+        await withTaskGroup(of: Void.self) { group in
+            for _ in 0..<32 {
+                group.addTask {
+                    if latch.claimNativeCancellation() {
+                        await claims.increment()
+                    }
+                }
+            }
+        }
+
+        #expect(await claims.value == 1)
+    }
+
+    @Test func cancellationAfterInitialStartPreventsResume() {
+        let latch = UploadCancellationLatch()
+
+        #expect(latch.claimStart())
+        latch.requestCancellation()
+
+        #expect(!latch.claimStart(), "a cancelled operation must not resume after its first start")
+    }
+
+    @Test func rollbackRunsEverySetupCleanupAfterAnErrorAndOnlyOnce() async {
+        for failedStage in 0..<9 {
+            let counter = CleanupCounter()
+            let transaction = UploadResourceTransaction()
+            let cleanupStages: [UploadResourceCleanupStage] = [
+                .cancellationToken,
+                .uploader,
+                .buffers,
+                .controller,
+                .controller,
+                .uploader,
+                .buffers,
+                .cancellationToken,
+                .nativeCancellationBarrier,
+            ]
+
+            for stage in 0..<9 {
+                transaction.add(stage: cleanupStages[stage]) {
+                    await counter.record(stage)
+                    if stage == failedStage {
+                        struct SetupFailure: Error {}
+                        throw SetupFailure()
+                    }
+                }
+            }
+
+            await transaction.rollback()
+            await transaction.rollback()
+
+            #expect(await counter.count == 9, "failure stage \(failedStage) must not strand later resources")
+            #expect(await counter.uniqueStages.count == 9)
+        }
+    }
+
+    @Test func rollbackUsesNativeDependencyOrder() async {
+        let counter = CleanupCounter()
+        let transaction = UploadResourceTransaction()
+
+        transaction.add(stage: .cancellationToken) { await counter.record(4) }
+        transaction.add(stage: .uploader) { await counter.record(2) }
+        transaction.add(stage: .buffers) { await counter.record(3) }
+        transaction.add(stage: .controller) { await counter.record(1) }
+        transaction.add(stage: .nativeCancellationBarrier) { await counter.record(0) }
+
+        await transaction.rollback()
+
+        #expect(await counter.stages == [0, 1, 2, 3, 4])
+    }
+
+    @Test func operationOwnershipReleasesEveryResourceExactlyOnce() async {
+        let counter = CleanupCounter()
+        let transaction = UploadResourceTransaction()
+        for stage in 0..<5 {
+            transaction.add(stage: UploadResourceCleanupStage(rawValue: stage)!) {
+                await counter.record(stage)
+            }
+        }
+
+        transaction.transferToOperation()
+        await transaction.rollback()
+        #expect(await counter.count == 0, "setup rollback must not free transferred resources")
+
+        let owner = UploadOperationResourceOwner(transaction: transaction) {}
+        async let first: Void = owner.release()
+        async let second: Void = owner.release()
+        _ = await (first, second)
+
+        #expect(await counter.count == 5)
+        #expect(await counter.uniqueStages.count == 5)
+    }
+
+    @Test func undeliveredOperationDisposesRemoteControllerBeforeLocalFree() async {
+        let counter = CleanupCounter()
+        let transaction = UploadResourceTransaction()
+        transaction.add(stage: .controller) { await counter.record(2) }
+        transaction.addRollbackOnly(stage: .controller) { await counter.record(1) }
+        transaction.transferToOperation()
+        let owner = UploadOperationResourceOwner(transaction: transaction) {}
+
+        await owner.releaseUndelivered()
+        await owner.release()
+
+        #expect(await counter.stages == [1, 2])
+    }
+
+    @Test func faultInjectionLeavesEveryAbstractResourceCounterAtZero() async {
+        let cleanupStages: [UploadResourceCleanupStage] = [
+            .cancellationToken, // token creation
+            .uploader,          // uploader creation
+            .buffers,           // thumbnail buffer creation
+            .controller,        // request send/controller creation
+            .controller,        // operation construction handoff
+        ]
+
+        for failureAfterAllocation in 0...cleanupStages.count {
+            let resources = ResourceBalance()
+            let transaction = UploadResourceTransaction()
+            for (index, stage) in cleanupStages.enumerated() where index < failureAfterAllocation {
+                await resources.allocate(index)
+                transaction.add(stage: stage) {
+                    await resources.release(index)
+                    if index == 1 && failureAfterAllocation == cleanupStages.count {
+                        struct NativeFreeFailure: Error {}
+                        throw NativeFreeFailure()
+                    }
+                }
+            }
+            // A native cancellation failure is represented by a failing barrier. It must not stop
+            // the remaining resource cleanup stages.
+            transaction.add(stage: .nativeCancellationBarrier) {
+                if failureAfterAllocation == cleanupStages.count {
+                    struct NativeCancelFailure: Error {}
+                    throw NativeCancelFailure()
+                }
+            }
+
+            await transaction.rollback()
+            #expect(await resources.total == 0, "fault stage \(failureAfterAllocation) leaked a resource")
+        }
+    }
+
+    @Test func asyncNativeFreeIsStartedOnceAndEveryCallerJoinsCompletion() async {
+        let gate = IdempotentAsyncFreeGate()
+        let entered = AsyncFreeLatch()
+        let release = AsyncFreeLatch()
+        let returned = AsyncFreeLatch()
+        let starts = ClaimCounter()
+
+        let first = gate.task {
+            Task {
+                await starts.increment()
+                await entered.signal()
+                await release.wait()
+            }
+        }
+        await entered.wait()
+        let second = gate.task {
+            Task { await starts.increment() }
+        }
+        let waiter = Task {
+            await second.value
+            await returned.signal()
+        }
+
+        await Task.yield()
+        #expect(!(await returned.isOpen))
+        #expect(await starts.value == 1)
+
+        await release.signal()
+        await first.value
+        await waiter.value
+        #expect(await returned.isOpen)
+        #expect(await starts.value == 1)
+    }
+}
+
+private actor AsyncFreeLatch {
+    private var open = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+
+    var isOpen: Bool { open }
+
+    func wait() async {
+        if open { return }
+        await withCheckedContinuation { waiters.append($0) }
+    }
+
+    func signal() {
+        guard !open else { return }
+        open = true
+        let pending = waiters
+        waiters.removeAll(keepingCapacity: false)
+        pending.forEach { $0.resume() }
+    }
+}
+
+private actor ClaimCounter {
+    private(set) var value = 0
+
+    func increment() {
+        value += 1
+    }
+}
+
+private actor CleanupCounter {
+    private(set) var stages: [Int] = []
+
+    func record(_ stage: Int) {
+        stages.append(stage)
+    }
+
+    var count: Int { stages.count }
+    var uniqueStages: Set<Int> { Set(stages) }
+}
+
+private actor ResourceBalance {
+    private var balances: [Int: Int] = [:]
+
+    func allocate(_ resource: Int) {
+        balances[resource, default: 0] += 1
+    }
+
+    func release(_ resource: Int) {
+        balances[resource, default: 0] -= 1
+    }
+
+    var total: Int { balances.values.reduce(0, +) }
+}
