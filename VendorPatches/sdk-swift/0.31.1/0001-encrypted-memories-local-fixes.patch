+    private let lock = NSLock()
+    private var task: Task<Void, Never>?
+
+    func task(create: () -> Task<Void, Never>) -> Task<Void, Never> {
+        lock.withLock {
+            if let task { return task }
+            let task = create()
+            self.task = task
+            return task
+        }
+    }
+}
