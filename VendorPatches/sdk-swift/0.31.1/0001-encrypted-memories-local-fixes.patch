diff --git a/Sources/FileOperations/Uploads/UploadLifecycleSupport.swift b/Sources/FileOperations/Uploads/UploadLifecycleSupport.swift
new file mode 100644
index 0000000..825b19a
--- /dev/null
+++ b/Sources/FileOperations/Uploads/UploadLifecycleSupport.swift
@@ -0,0 +1,300 @@
+import Foundation
+
+/// Thread-safe cancellation state shared by the SDK upload setup path and its operation.
+///
+/// The upload managers install this latch before their first suspension point. A cancellation can
+/// therefore be recorded before the native cancellation token exists and can never claim the native
+/// cancel operation more than once.
+final class UploadCancellationLatch: @unchecked Sendable {
+    private let lock = NSLock()
+    private var requested = false
+    private var nativeCancellationClaimed = false
+    private var startClaimed = false
+
+    var isCancellationRequested: Bool {
+        lock.withLock { requested }
+    }
+
+    func requestCancellation() {
+        lock.withLock { requested = true }
+    }
+
+    func claimNativeCancellation() -> Bool {
+        lock.withLock {
+            guard !nativeCancellationClaimed else { return false }
+            nativeCancellationClaimed = true
+            return true
+        }
+    }
+
+    /// Atomically claims the first upload start against cancellation.
+    ///
+    /// Later calls are idempotent because callers may enter through both a convenience API and the
+    /// operation API. Cancellation always wins over a later start or resume request, including
+    /// after the operation started once.
+    func claimStart() -> Bool {
+        lock.withLock {
+            guard !requested else { return false }
+            if startClaimed { return true }
+            startClaimed = true
+            return true
+        }
+    }
+
+    func check() throws {
+        try Task.checkCancellation()
+        if isCancellationRequested {
+            throw CancellationError()
+        }
+    }
+}
+
+/// Dependency order for native upload cleanup.
+///
+/// A controller can still reference the uploader and thumbnail pointers. The cancellation barrier
+/// therefore completes first, followed by controller, uploader, buffers, and token source.
+enum UploadResourceCleanupStage: Int, Sendable {
+    case nativeCancellationBarrier
+    case controller
+    case uploader
+    case buffers
+    case cancellationToken
+}
+
+/// Best-effort server-side cleanup for a controller that was created during setup but never
+/// transferred to an `UploadOperation`. Setup rollback must dispose the remote draft before it
+/// releases the local controller handle.
+func disposeUploadController(_ uploadControllerHandle: Int64, logger: Logger?) async {
+    let request = Proton_Drive_Sdk_UploadControllerDisposeRequest.with {
+        $0.uploadControllerHandle = uploadControllerHandle
+    }
+    do {
+        try await SDKRequestHandler.send(request, logger: logger) as Void
+    } catch {
+        logger?.error(
+            "Proton_Drive_Sdk_UploadControllerDisposeRequest failed: \(error)",
+            category: "UploadController.disposeFileUploadController"
+        )
+    }
+}
+
+/// Owns setup resources until an UploadOperation takes ownership of them.
+///
+/// Every registered cleanup runs at most once. Rollback continues after a cleanup error because
+/// one failed native free must not strand the remaining resources.
+final class UploadResourceTransaction: @unchecked Sendable {
+    private enum Ownership: Equatable {
+        case setup
+        case operation
+        case released
+    }
+
+    private struct Entry: Sendable {
+        let stage: UploadResourceCleanupStage
+        let ordinal: UInt64
+        let rollbackOnly: Bool
+        let cleanup: @Sendable () async throws -> Void
+    }
+
+    private let lock = NSLock()
+    private var cleanups: [Entry] = []
+    private var nextOrdinal: UInt64 = 0
+    private var ownership = Ownership.setup
+
+    func add(
+        stage: UploadResourceCleanupStage,
+        _ cleanup: @escaping @Sendable () async throws -> Void
+    ) {
+        add(stage: stage, rollbackOnly: false, cleanup)
+    }
+
+    /// Registers cleanup that is valid only when setup never transfers ownership to an operation.
+    /// This is used for server-side draft disposal; a completed operation owns its own disposal
+    /// decision and must not receive a second rollback request during local resource release.
+    func addRollbackOnly(
+        stage: UploadResourceCleanupStage,
+        _ cleanup: @escaping @Sendable () async throws -> Void
+    ) {
+        add(stage: stage, rollbackOnly: true, cleanup)
+    }
+
+    private func add(
+        stage: UploadResourceCleanupStage,
+        rollbackOnly: Bool,
+        _ cleanup: @escaping @Sendable () async throws -> Void
+    ) {
+        lock.withLock {
+            precondition(ownership == .setup, "upload cleanup registered after ownership transfer")
+            cleanups.append(
+                Entry(stage: stage, ordinal: nextOrdinal, rollbackOnly: rollbackOnly, cleanup: cleanup)
+            )
+            nextOrdinal &+= 1
+        }
+    }
+
+    /// Transfers every setup resource to the successfully constructed operation.
+    func transferToOperation() {
+        lock.withLock {
+            precondition(ownership == .setup, "upload resource ownership transferred more than once")
+            ownership = .operation
+        }
+    }
+
+    func rollback() async {
+        await release(expectedOwner: .setup, includeRollbackOnly: true)
+    }
+
+    func releaseOperationResources() async {
+        await release(expectedOwner: .operation, includeRollbackOnly: false)
+    }
+
+    /// Releases an operation that setup constructed but never returned to its caller. Its remote-draft
+    /// rollback actions must run before the ordinary local controller cleanup.
+    func releaseUndeliveredOperationResources() async {
+        await release(expectedOwner: .operation, includeRollbackOnly: true)
+    }
+
+    private func release(expectedOwner: Ownership, includeRollbackOnly: Bool) async {
+        let pending = lock.withLock { () -> [Entry] in
+            guard ownership == expectedOwner else { return [] }
+            ownership = .released
+            let pending = cleanups.sorted {
+                if $0.stage.rawValue != $1.stage.rawValue {
+                    return $0.stage.rawValue < $1.stage.rawValue
+                }
+                return $0.ordinal > $1.ordinal
+            }
+            cleanups.removeAll(keepingCapacity: false)
+            return pending.filter { includeRollbackOnly || !$0.rollbackOnly }
+        }
+        for cleanup in pending {
+            try? await cleanup.cleanup()
+        }
+    }
+}
+
+/// Idempotent operation-side owner for the transferred setup transaction.
+final class UploadOperationResourceOwner: @unchecked Sendable {
+    private let transaction: UploadResourceTransaction
+    private let onDispose: @Sendable () async -> Void
+    private let lock = NSLock()
+    private var releaseTask: Task<Void, Never>?
+
+    init(
+        transaction: UploadResourceTransaction,
+        onDispose: @escaping @Sendable () async -> Void
+    ) {
+        self.transaction = transaction
+        self.onDispose = onDispose
+    }
+
+    func release() async {
+        await release(includeRollbackOnly: false)
+    }
+
+    func releaseUndelivered() async {
+        await release(includeRollbackOnly: true)
+    }
+
+    private func release(includeRollbackOnly: Bool) async {
+        let task = lock.withLock { () -> Task<Void, Never> in
+            if let releaseTask { return releaseTask }
+            let transaction = transaction
+            let onDispose = onDispose
+            let task = Task {
+                if includeRollbackOnly {
+                    await transaction.releaseUndeliveredOperationResources()
+                } else {
+                    await transaction.releaseOperationResources()
+                }
+                await onDispose()
+            }
+            releaseTask = task
+            return task
+        }
+        await task.value
+    }
+}
+
+/// Per-token state retained while the SDK builds an UploadOperation.
+final class ActiveUploadState: @unchecked Sendable {
+    let cancellation = UploadCancellationLatch()
+
+    private let lock = NSLock()
+    private var tokenSource: CancellationTokenSource?
+    private var nativeCancellationSource: CancellationTokenSource?
+    private var bufferCleanup: (@Sendable () -> Void)?
+    private var nativeCancellationTask: Task<Void, Error>?
+    private var operationOwned = false
+    private var cancellationRegistrationClosed = false
+
+    func install(tokenSource: CancellationTokenSource) {
+        lock.withLock { self.tokenSource = tokenSource }
+    }
+
+    /// Closes the cancellation-registration window before resource cleanup snapshots its barrier.
+    /// A late cancellation then observes that cleanup already won and cannot claim a token that is
+    /// being released by the final token stage.
+    func closeCancellationRegistration() {
+        lock.withLock { cancellationRegistrationClosed = true }
+    }
+
+    /// Atomically transfers the token source to one native cancellation task.
+    /// Resource cleanup can await the same task before freeing dependent native handles.
+    func beginNativeCancellation() -> Task<Void, Error>? {
+        lock.withLock {
+            guard !cancellationRegistrationClosed,
+                  nativeCancellationTask == nil,
+                  let source = tokenSource else { return nil }
+            tokenSource = nil
+            nativeCancellationSource = source
+            let task = Task { try await source.cancel() }
+            nativeCancellationTask = task
+            return task
+        }
+    }
+
+    func waitForNativeCancellation() async {
+        let task = lock.withLock { nativeCancellationTask }
+        _ = try? await task?.value
+    }
+
+    func setBufferCleanup(_ cleanup: @escaping @Sendable () -> Void) {
+        lock.withLock { bufferCleanup = cleanup }
+    }
+
+    func releaseBuffers() {
+        let cleanup = lock.withLock { () -> (@Sendable () -> Void)? in
+            let cleanup = bufferCleanup
+            bufferCleanup = nil
+            return cleanup
+        }
+        cleanup?()
+    }
+
+    func releaseTokenSource() async {
+        let (source, cancellationTask) = lock.withLock { () -> (CancellationTokenSource?, Task<Void, Error>?) in
+            let source = tokenSource ?? nativeCancellationSource
+            tokenSource = nil
+            nativeCancellationSource = nil
+            return (source, nativeCancellationTask)
+        }
+        _ = try? await cancellationTask?.value
+        await source?.freeAndWait()
+    }
+
+    func releaseResources() async {
+        closeCancellationRegistration()
+        await waitForNativeCancellation()
+        releaseBuffers()
+        await releaseTokenSource()
+    }
+
+    func markOperationOwned() {
+        lock.withLock { operationOwned = true }
+    }
+
+    func ownsOperation() -> Bool {
+        lock.withLock { operationOwned }
+    }
+}
