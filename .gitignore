# Build output
build/
.build/
DerivedData/
*.xcresult
*.dSYM/
*.app/
*.log
*.abi.json
*.swiftdoc
*.swiftmodule
*.swiftsourceinfo

# Xcode local state
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Generated Xcode project (regenerated from project.yml via xcodegen)
EncryptedMemories.xcodeproj/

# Vendored SDK clone (re-clone via: git clone --branch 0.32.1 https://github.com/ProtonDriveApps/sdk-swift Vendor/sdk-swift)
Vendor/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.localized
Icon?
__MACOSX/
.Spotlight-V100/
.Trashes/
.fseventsd/
.DocumentRevisions-V100/
.TemporaryItems/
.VolumeIcon.icns

# Local source snapshots and archives
Archiv.zip
*.zip

# Local Markdown notes and reports. Public documentation must be allow-listed.
*.md
!/README.md
!/AGENTS.md
!/SECURITY.md
!/CONTRIBUTING.md
!/.github/pull_request_template.md
!/Wiki/
!/Wiki/**/*.md
!/Tools/MLModels/README.md
!/Tools/MLModels/SigLIP2/README.md

# Apple release credentials and exported archives never enter the repository.
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.ipa
*.xcarchive/

# Local development and private review output
.claude/
.wrangler/
artifacts/
reports/
__pycache__/
*.py[cod]
.pytest_cache/

# SwiftPM
Packages/*/.build/
Packages/*/.swiftpm/xcode/xcuserdata/
*.resolved
!/Packages/EncryptedMemoriesKit/Package.resolved
!/BuildSupport/Package.resolved

# Local marketing production material. Only site/ is published through GitHub Pages.
/Marketing/
/site/assets/*.m4v
/site/assets/*.mov
/site/assets/*.mp4
