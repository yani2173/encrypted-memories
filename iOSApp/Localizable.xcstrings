    "settings.photos_backup_sync_now": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up now"
          }
        }
      }
    },
    "settings.photos_backup_background_note": {
      "extractionState": "manual",
      "comment": "Honest iOS background wording: checkpointed backup uses system-granted background processing windows and resumes automatically.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung nutzt verfügbare Hintergrundzeit. iOS kann sie pausieren und später automatisch fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup uses available background time. iOS may pause it and resume it automatically later."
          }
        }
      }
    },
    "settings.section_backup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        }
      }
    },
    "settings.section_features": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Funktionen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Features" } }
      }
    },
    "settings.albumsync_summary %lld": {
      "extractionState": "manual",
      "comment": "Trailing value of the album sync settings row: number of synced albums.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": { "stringUnit": { "state": "translated", "value": "%lld album" } },
              "other": { "stringUnit": { "state": "translated", "value": "%lld albums" } }
