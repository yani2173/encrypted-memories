{
  "sourceLanguage": "en",
  "strings": {
    "settings.photos_backup_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto-Backup ist nicht verfügbar, weil der Duplikatschutz nicht initialisiert werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos backup is unavailable because duplicate protection could not be initialized."
          }
        }
      }
    },
    "settings.albumsync_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Synchronisierung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album Sync"
          }
        }
      }
    },
    "settings.albumsync_unavailable": {
      "extractionState": "manual",
      "comment": "Shown when the album-sync mapping database or duplicate protection could not be opened.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Synchronisierung ist nicht verfügbar, weil die lokale Datenbank nicht geöffnet werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album sync is unavailable because its local database could not be opened."
          }
        }
      }
    },
    "settings.albumsync_stop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "settings.photos_backup_open_settings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
